# Admin credentials (frontend-only; not fully secure)
VITE_ADMIN_USER=
VITE_ADMIN_PASS=

# Optional: endpoint to receive events (must accept POST for events and GET to list)
# If omitted, events are saved in localStorage and read from there by the admin page
VITE_EVENT_ENDPOINT=

# Configurable admin path (default: /admin). Example: VITE_ADMIN_PATH=/mi-secreto
VITE_ADMIN_PATH=/admin

# Vercel analytics note: to use @vercel/analytics you must deploy the app to Vercel
# and enable Analytics in the Vercel dashboard. The <Analytics /> component is
# already imported in the app (add it to the JSX if you want to use it in production).
